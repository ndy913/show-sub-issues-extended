{
  "manifest_version": 3,
  "name": "Linear · Show sub-issues extended",
  "version": "0.8.2",
  "description": "Extends Linear's Show sub-issues option: collapse sub-issues under their parent, count them, tint them by depth.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://linear.app/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Linear · Show sub-issues extended",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://linear.app/*"
      ],
      "js": [
        "options.js",
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://linear.app/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "short_name": "Sub-issues extended",
  "homepage_url": "https://github.com/ndy913/show-sub-issues-extended"
}
